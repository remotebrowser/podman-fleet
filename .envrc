# Toolchain (python 3.11, uv, make, podman) from flake.nix.
use flake

# uv owns the venv. Create it on first entry so `make dev` works straight away
# rather than failing on a missing interpreter.
if [ ! -d .venv ]; then
  uv sync
fi

# Puts pytest/ruff/uvicorn on PATH so they can be run without the `uv run`
# prefix the Makefile uses. PATH_add rather than `activate`: direnv unwinds it
# when you leave the directory, an activated venv would linger.
PATH_add .venv/bin

# Settings are read from .env by pydantic-settings, which loads the file itself —
# this exports the same values so ad-hoc shell commands (curl, podman --remote)
# see them too. .env is gitignored; start from .env.template.
dotenv_if_exists .env
